{
  "name": "noxvr-documentation",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run generate && next build",
    "dev": "npm run generate && next dev --turbo",
    "start": "next start",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "generate": "npx tsx scripts/generate-docs.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "fumadocs-core": "16.0.13",
    "fumadocs-mdx": "14.0.1",
    "fumadocs-openapi": "^10.0.8",
    "fumadocs-twoslash": "^3.1.10",
    "fumadocs-ui": "16.0.13",
    "lucide-react": "^0.552.0",
    "next": "16.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^3.15.0",
    "twoslash": "^0.3.4",
    "vite": "^7.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
